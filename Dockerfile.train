FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 trainer
COPY common ./common
COPY backend ./backend
COPY ml_service ./ml_service
COPY training ./training
USER trainer
ENTRYPOINT ["python", "-m", "training.refit_hgbr"]
